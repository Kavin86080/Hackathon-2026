# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: The port the server runs on (defaults to 3000)
PORT=3000

# DATABASE_URL: MySQL or persistent storage connection string
DATABASE_URL="mysql://user:Rizwan@123localhost:3306/explaingrade_ai"

# JWT_SECRET: Secret for signing session tokens
JWT_SECRET="explaingrade-ai-super-secret-jwt-key-2024"

# VECTOR_DB_PATH: Path for local vector embeddings cache / knowledge base store
VECTOR_DB_PATH="./data/vector_store"
